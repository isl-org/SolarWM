#define SYCL_INTEL_TARGET 20
#define CUTLASS_ENABLE_SYCL 1
#include <sycl/sycl.hpp>
#include <sycl/ext/intel/experimental/grf_size_properties.hpp>
#include <sycl/ext/oneapi/experimental/group_load_store.hpp>
#include <torch/extension.h>
#include <c10/xpu/XPUStream.h>
#include <cute/tensor.hpp>
#include <string>
#include <set>
#include <functional>
#include "tuning_params.h"
#include "autotune.hpp"

// KF_GRF / KF_N_TILE are the legacy single-configuration knobs of the task harness. The GEMM now compiles a
// pool of configurations (see KF_GEMM_VARIANTS) and selects among them at run time, so they are no longer used
// by the GEMM; they remain defined so existing hyperparameter plumbing keeps building.
#ifndef KF_GRF
#define KF_GRF 128
#endif

#if KF_GRF != 128 && KF_GRF != 256
#error "KF_GRF must be 128 or 256"
#endif

#ifndef KF_N_TILE
#define KF_N_TILE 64
#endif

#if KF_N_TILE != 64 && KF_N_TILE != 128
#error "KF_N_TILE (GEMM columns per sub-group) must be 64 or 128"
#endif

namespace py = pybind11;

/*
[USER_INSTRUCTIONS_START]
Create sycl kernels using the sycl-tla library.
Workload: SolarWM Wan2.2 TI2V-5B Camera Transformer Block Projections & FFN
- Active sequence length: M = 1215 tokens (3 frames * 405 tokens/frame)
- BF16 LoRA rank: r = 32
- Group size: G = 64
1. Projection 0 (Q): M = 1215, K = 3072, N = 3072, LoRA rank 32, with optional RMSNorm (WanRMSNorm dim=3072, eps=1e-5)
2. Projection 1 (K): M = 1215, K = 3072, N = 3072, LoRA rank 32, with optional RMSNorm (WanRMSNorm dim=3072, eps=1e-5)
3. Projection 2 (V): M = 1215, K = 3072, N = 3072, LoRA rank 32, no normalization
4. FFN up-projection: M = 1215, K = 3072, N = 14336, LoRA rank 32, activation gelu_tanh, optional fused INT4 output quantization
5. FFN down-projection: M = 1215, K = 14336, N = 3072, LoRA rank 32, no activation

Optimization directives:
- Input handling: Quantization should be optional. If input x is already in INT4 (from a preceding layer with fused output quantization), do not quantize. If input x is BF16, dynamic INT4 group-64 quantization must be fused on the fly inside the SYCL kernel (similar to Nunchaku SVDQuant).
- Fused LoRA: LoRA (x @ lora_a^T @ lora_b^T) must be calculated on the fly inside the SYCL kernel without separate PyTorch passes.
- Dual GEMM: In the main loop, perform a dual GEMM (INT4 MMA, scale it and accumulate into the BF16 LoRA MMA). Alternately, use XMX / dpas for the INT4 GEMM and vector engines for the LoRA BF16 branch in the epilogue.
- Epilogue features:
  - Fused bias addition.
  - Optional RMSNorm normalization for query and key projections, following the Wan2.2-5B model.
  - Optional non-linearities (gelu_tanh, silu).
  - Optional fused output INT4 quantization (qout and oscales) in the epilogue to chain inter-layer execution without HBM round-trips.
[USER_INSTRUCTIONS_END]
*/

// [EVOLVE_START]
namespace syclex = sycl::ext::oneapi::experimental;
namespace intelex = sycl::ext::intel::experimental;

constexpr int kSG = 16;       // sub-group size required by DPAS
constexpr int kTileM = 8;     // DPAS repeat count: rows per sub-group
constexpr int kTilesN = 4;    // 16-column DPAS tiles per sub-group: 64 columns = one quant group
constexpr int kGroup = 64;

template <typename T, int N>
using vec_t = T __attribute__((ext_vector_type(N)));
using f32x8 = vec_t<float, 8>;
using s32x8 = vec_t<int32_t, 8>;
using u32x8 = vec_t<uint32_t, 8>;
using u16x8 = vec_t<uint16_t, 8>;
using coord2 = vec_t<int, 2>;  // (column, row) of a 2D block message

using MmaInt4 = cute::XE_DPAS_TT<kTileM, int32_t, cute::int4_t, cute::int4_t>;
static_assert(MmaInt4::K == kGroup, "one INT4 DPAS step must span exactly one quantization group");

// 2D block messages on a row-major surface (byte width/pitch, row count); rows outside the
// surface read as zero and are not written. Element m of lane l = (row + m, column + l), and
// for the v2 read element 16 b + m = (row + m, column + 16 b + l).
using u16x32 = vec_t<uint16_t, 32>;
SYCL_EXTERNAL extern "C" u16x32 __builtin_IB_subgroup_block_read_flat_u16_m16k16v2(
    intptr_t base, int width_minus_one, int height_minus_one, int pitch_minus_one, coord2 coord);
SYCL_EXTERNAL extern "C" u16x8 __builtin_IB_subgroup_block_read_flat_u16_m8k16v1(
    intptr_t base, int width_minus_one, int height_minus_one, int pitch_minus_one, coord2 coord);
SYCL_EXTERNAL extern "C" u32x8 __builtin_IB_subgroup_block_read_flat_u32_m8k16v1(
    intptr_t base, int width_minus_one, int height_minus_one, int pitch_minus_one, coord2 coord);
SYCL_EXTERNAL extern "C" void __builtin_IB_subgroup_block_write_flat_u16_m8k16v1(
    intptr_t base, int width_minus_one, int height_minus_one, int pitch_minus_one, coord2 coord, u16x8 data);

inline float bf16_to_f32(uint16_t v) {
    return sycl::bit_cast<float>(uint32_t(v) << 16);
}

inline uint16_t f32_to_bf16(float v) {
    uint32_t bits = sycl::bit_cast<uint32_t>(v);
    return uint16_t((bits + 0x7FFFu + ((bits >> 16) & 1u)) >> 16);
}

inline float fast_tanh(float x) {
#ifdef __SYCL_DEVICE_ONLY__
    const float z = sycl::clamp(x, -10.0f, 10.0f);
    const float e2 = sycl::native::exp(2.0f * z);
    return (e2 - 1.0f) / (e2 + 1.0f);
#else
    return sycl::tanh(x);
#endif
}

inline float fast_exp(float x) {
#ifdef __SYCL_DEVICE_ONLY__
    return sycl::native::exp(x);
#else
    return sycl::exp(x);
#endif
}

inline float gelu_tanh(float x) {
    const float z = 0.7978845608028654f * (x + 0.044715f * x * x * x);
    return 0.5f * x * (1.0f + fast_tanh(z));
}

inline float silu(float x) {
    return x / (1.0f + fast_exp(-x));
}

// Round half away from zero, clamped to [-8, 7], as the low nibble.
inline uint32_t quant_nibble(float v, float inv_scale) {
    const float s = v * inv_scale;
    return uint32_t(sycl::clamp(int(s >= 0.0f ? s + 0.5f : s - 0.5f), -8, 7)) & 0xFu;
}

// Register images (one vector element per row / dword, all 16 lanes):
//   INT4 A: element m of lane l = K [4l, 4l + 4) of row m.
//   INT4 B: dword d of lane n = K [8d, 8d + 8) of column n, low nibble first.
//   BF16 A: element m of lane l = A[m][l].  BF16 B: dword d of lane n = B[2d..2d+1][n],
//   i.e. 32 contiguous bytes of row n of a row-major [N, K] matrix.
//   D: element m of lane n = D[m][n].
inline void dpas_s4(s32x8& d, u16x8 const& a, u32x8 const& b) {
#ifdef __SYCL_DEVICE_ONLY__
    asm("{\n"
        ".decl DST     v_type=G type=d  num_elts=128 alias=<%0,0>\n"
        ".decl SRC1_UD v_type=G type=UD num_elts=128 alias=<%2,0>\n"
        ".decl SRC2_UD v_type=G type=UD num_elts=64  alias=<%1,0>\n"
        "dpas.s4.s4.8.8 (M1, 16) DST.0 %%null.0 SRC1_UD.0 SRC2_UD(0,0)\n"
        "}\n"
        : "=rw"(d) : "rw"(a), "rw"(b));
#endif
}

inline void dpas_bf16(f32x8& d, u16x8 const& a, u32x8 const& b) {
#ifdef __SYCL_DEVICE_ONLY__
    asm("{\n"
        ".decl DST     v_type=G type=f  num_elts=128 alias=<%0,0>\n"
        ".decl SRC1_UD v_type=G type=UD num_elts=128 alias=<%2,0>\n"
        ".decl SRC2_UD v_type=G type=UD num_elts=64  alias=<%1,0>\n"
        "dpas.bf.bf.8.8 (M1, 16) DST.0 DST.0 SRC1_UD.0 SRC2_UD(0,0)\n"
        "}\n"
        : "+rw"(d) : "rw"(a), "rw"(b));
#endif
}

// Lane l receives src[16 i + l] as element i.
template <typename T, int N>
inline sycl::vec<T, N> block_load(sycl::sub_group sg, const T* src) {
    sycl::vec<T, N> v;
    syclex::group_load(
        sg, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(src), v,
        syclex::properties{syclex::data_placement_striped, syclex::contiguous_memory, syclex::full_group});
    return v;
}

inline u32x8 load_b_image(sycl::sub_group sg, const uint32_t* src) {
    return sycl::bit_cast<u32x8>(block_load<uint32_t, 8>(sg, src));
}

// Group-64 INT4 quantization of an 8 x 64 tile held as v[t][m] = (row m, column 16 t + lane).
// Row m (if m < rows) is written as 32 packed bytes (even column in the low nibble) at
// dst + m * ld. The scale is amax * rho / 7 (rho < 1 clips outliers). Returns the scale of
// row lane / 2.
inline float quantize_tile8x64(sycl::sub_group sg, int lane, const float (&v)[kTilesN][kTileM],
                               int8_t* dst, size_t ld, int rows, float rho) {
    float amax[kTileM];
    #pragma unroll
    for (int m = 0; m < kTileM; ++m)
        amax[m] = sycl::fmax(sycl::fmax(sycl::fabs(v[0][m]), sycl::fabs(v[1][m])),
                             sycl::fmax(sycl::fabs(v[2][m]), sycl::fabs(v[3][m])));

    // Sub-group collectives: per-row max across lanes.
    float scale_row[kTileM];
    float inv_row[kTileM];
    #pragma unroll
    for (int m = 0; m < kTileM; ++m) {
        const float mx = sycl::reduce_over_group(sg, amax[m], sycl::maximum<float>());
        const float s = sycl::fmax(mx * rho / 7.0f, 1e-8f);
        scale_row[m] = s;
        inv_row[m] = 1.0f / s;
    }

    // Row pair p: lane L stores dword L % 8 (columns 8 (L % 8) .. + 8) of row 2 p + L / 8.
    #pragma unroll
    for (int p = 0; p < kTileM / 2; ++p) {
        uint32_t d = 0;
        #pragma unroll
        for (int half = 0; half < 2; ++half) {
            const int m = 2 * p + half;
            const float inv = inv_row[m];
            #pragma unroll
            for (int t = 0; t < kTilesN; ++t) {
                const uint32_t q = quant_nibble(v[t][m], inv);
                uint32_t w = q | (sycl::shift_group_left(sg, q, 1) << 4);  // even lanes: 1 byte
                w |= sycl::shift_group_left(sg, w, 2) << 8;                 // lanes 4i: 2 bytes
                w |= sycl::shift_group_left(sg, w, 4) << 16;                // lanes 8h: dword 2t + h
                const uint32_t pick = sycl::select_from_group(sg, w, 8 * (lane & 1));
                if ((lane >> 3) == half && ((lane & 7) >> 1) == t) d = pick;
            }
        }
        const int row = 2 * p + (lane >> 3);
        if (row < rows) *reinterpret_cast<uint32_t*>(dst + row * ld + 4 * (lane & 7)) = d;
    }
    return scale_row[lane >> 1];
}

// Lane-local group-64 INT4 quantization of 64 bf16 values held as 32 dwords (column 2i in the
// low half of dword i). packed[j] receives columns 8j .. 8j + 7, low nibble first. Values are
// multiplied by sinv[column] (if non-null, uniform across lanes) before quantization, and the
// scale is amax * rho / 7.
inline float quantize_group_lane(const u32x8 (&x)[kTilesN], u32x8& packed, const float* sinv, float rho) {
    float amax = 0.0f;
    #pragma unroll
    for (int kb = 0; kb < kTilesN; ++kb) {
        #pragma unroll
        for (int d = 0; d < 8; ++d) {
            float lo = sycl::bit_cast<float>(x[kb][d] << 16);
            float hi = sycl::bit_cast<float>(x[kb][d] & 0xFFFF0000u);
            if (sinv != nullptr) {
                lo *= sinv[16 * kb + 2 * d];
                hi *= sinv[16 * kb + 2 * d + 1];
            }
            amax = sycl::fmax(amax, sycl::fmax(sycl::fabs(lo), sycl::fabs(hi)));
        }
    }
    const float scale = sycl::fmax(amax * rho / 7.0f, 1e-8f);
    const float inv = 1.0f / scale;
    #pragma unroll
    for (int j = 0; j < 8; ++j) {
        uint32_t w = 0;
        #pragma unroll
        for (int i = 0; i < 4; ++i) {
            const int kb = j / 2, dd = 4 * (j % 2) + i;
            const uint32_t d = x[kb][dd];
            float lo = sycl::bit_cast<float>(d << 16);
            float hi = sycl::bit_cast<float>(d & 0xFFFF0000u);
            if (sinv != nullptr) {
                lo *= sinv[16 * kb + 2 * dd];
                hi *= sinv[16 * kb + 2 * dd + 1];
            }
            w |= (quant_nibble(lo, inv) | (quant_nibble(hi, inv) << 4)) << (8 * i);
        }
        packed[j] = w;
    }
    return scale;
}

// ---------------------------------------------------------------------------------------
// Prologue: optional INT4 quantization of x and lora_act = x @ lora_a^T, in one pass over x.
// Lane n of a sub-group owns row n of a 16-row block, so the row's 64-column K group loads
// straight into the BF16 DPAS B operand and quantizes without cross-lane traffic; lora_a
// (row-major [R, K]) is the A operand via 2D block loads. A work-group of kProSGs sub-groups
// splits the rank in kRS parts and K in kKS contiguous ranges; partial products are reduced
// through SLM. Activation scales are stored group-major: x_scales_t[g * xs_ld + row].
// ---------------------------------------------------------------------------------------
constexpr int kProRows = kSG;
constexpr int kProSGs = 8;

template <int RT, bool QUANT> class SVDQ_Quant_int4_LoRa_bf16;

template <int RT, bool QUANT>
void launch_prologue(sycl::queue& q, const uint16_t* x, int M, int K, int8_t* x_q, float* x_scales_t, int xs_ld,
                     const float* smooth_inv, float rho, const uint16_t* lora_a, float* lora_act) {
    constexpr int R = RT * 16;
    constexpr int kRankBlocks = R / 8;                            // 8-row DPAS tiles of lora_a
    constexpr int kRS = kRankBlocks > 8 ? kRankBlocks / 8 : 1;    // keeps <= 8 accumulators
    constexpr int RB = kRankBlocks / kRS;
    constexpr int kPart = RB * kTileM * kSG;                     // floats of one sub-group's partial
    constexpr int kKS = kProSGs / kRS;
    static_assert(RB % 2 == 0, "rank must be a multiple of 16");
    const int G = K / kGroup;
    const int blocks = (M + kProRows - 1) / kProRows;
    q.submit([&](sycl::handler& h) {
        sycl::local_accessor<float, 1> slm(sycl::range<1>(RB > 0 ? kProSGs * kPart : 1), h);
        h.parallel_for<SVDQ_Quant_int4_LoRa_bf16<RT, QUANT>>(
            sycl::nd_range<1>(size_t(blocks) * kProSGs * kSG, kProSGs * kSG),
            syclex::properties{syclex::sub_group_size<kSG>, intelex::grf_size<(RB > 4 ? 256 : 128)>},
            [=](sycl::nd_item<1> item) {
                auto sg = item.get_sub_group();
                const int lane = sg.get_local_id()[0];
                const int s = sg.get_group_id()[0];
                const int rs = s % kRS, ks = s / kRS;
                const int m0 = int(item.get_group(0)) * kProRows;
                const int row = m0 + lane;
                const uint16_t* x_row = x + size_t(sycl::min(row, M - 1)) * K;

                f32x8 acc[RB > 0 ? RB : 1] = {};
                const int g_begin = ks * G / kKS, g_end = (ks + 1) * G / kKS;
                for (int g = g_begin; g < g_end; ++g) {
                    u32x8 xb[kTilesN];
                    #pragma unroll
                    for (int kb = 0; kb < kTilesN; ++kb) xb[kb] = *reinterpret_cast<const u32x8*>(x_row + g * kGroup + 16 * kb);
                    if constexpr (QUANT) {
                        if ((g - g_begin) % kRS == rs) {
                            u32x8 packed;
                            const float scale = quantize_group_lane(
                                xb, packed, smooth_inv != nullptr ? smooth_inv + g * kGroup : nullptr, rho);
                            if (row < M) {
                                *reinterpret_cast<u32x8*>(x_q + size_t(row) * (K / 2) + g * 32) = packed;
                                x_scales_t[size_t(g) * xs_ld + row] = scale;
                            }
                        }
                    }
                    #pragma unroll
                    for (int j = 0; j < RB / 2; ++j) {
                        #pragma unroll
                        for (int half = 0; half < 2; ++half) {
                            // 16 lora_a rows x 32 columns: element 16 b + r = (rank r0 + r, column 16 b + lane).
                            const auto la = __builtin_IB_subgroup_block_read_flat_u16_m16k16v2(
                                intptr_t(lora_a), K * 2 - 1, R - 1, K * 2 - 1,
                                coord2{g * kGroup + 32 * half, (rs * RB + 2 * j) * kTileM});
                            #pragma unroll
                            for (int b = 0; b < 2; ++b) {
                                #pragma unroll
                                for (int rr = 0; rr < 2; ++rr) {
                                    u16x8 a;
                                    #pragma unroll
                                    for (int m = 0; m < kTileM; ++m) a[m] = la[16 * b + kTileM * rr + m];
                                    dpas_bf16(acc[2 * j + rr], a, xb[2 * half + b]);
                                }
                            }
                        }
                    }
                }
                if constexpr (RB > 0) {
                    // acc[rb][m] of lane n = lora_act[m0 + n][(rs * RB + rb) * 8 + m].
                    #pragma unroll
                    for (int rb = 0; rb < RB; ++rb) {
                        #pragma unroll
                        for (int m = 0; m < kTileM; ++m) slm[s * kPart + (rb * kTileM + m) * kSG + lane] = acc[rb][m];
                    }
                    sycl::group_barrier(item.get_group());
                    for (int i = int(item.get_local_id(0)); i < kRS * kPart; i += kProSGs * kSG) {
                        const int part = i / kPart, j = i % kPart;
                        float sum = 0.0f;
                        #pragma unroll
                        for (int k = 0; k < kKS; ++k) sum += slm[(k * kRS + part) * kPart + j];
                        const int out_row = m0 + j % kSG;
                        if (out_row < M) lora_act[size_t(out_row) * R + part * RB * kTileM + j / kSG] = sum;
                    }
                }
            });
    });
}

template <bool QUANT>
void dispatch_prologue(sycl::queue& q, const uint16_t* x, int M, int K, int8_t* x_q, float* x_scales_t, int xs_ld,
                       const float* si, float rho, const uint16_t* lora_a, int R, float* lora_act) {
    switch (R) {
        case 0:   launch_prologue<0, QUANT>(q, x, M, K, x_q, x_scales_t, xs_ld, si, rho, lora_a, lora_act); break;
        case 16:  launch_prologue<1, QUANT>(q, x, M, K, x_q, x_scales_t, xs_ld, si, rho, lora_a, lora_act); break;
        case 32:  launch_prologue<2, QUANT>(q, x, M, K, x_q, x_scales_t, xs_ld, si, rho, lora_a, lora_act); break;
        case 64:  launch_prologue<4, QUANT>(q, x, M, K, x_q, x_scales_t, xs_ld, si, rho, lora_a, lora_act); break;
        case 96:  launch_prologue<6, QUANT>(q, x, M, K, x_q, x_scales_t, xs_ld, si, rho, lora_a, lora_act); break;
        case 128: launch_prologue<8, QUANT>(q, x, M, K, x_q, x_scales_t, xs_ld, si, rho, lora_a, lora_act); break;
        default:  TORCH_CHECK(false, "LoRA rank (total) must be 16, 32, 64, 96 or 128, got ", R);
    }
}

// ---------------------------------------------------------------------------------------
// Main GEMM: out[M, N] = act(dequant(x_q @ W^T) + lora_act @ lora_b^T + bias), with optional
// fused INT4 output quantization and per-(row, 64 columns) sums of squares for RMSNorm.
// Each sub-group owns an 8 x KF_N_TILE output tile.
// ---------------------------------------------------------------------------------------
enum Act : int { kActNone, kActGeluTanh, kActSilu };

struct GemmArgs {
    const int8_t* x_q;
    const float* x_scales;      // [M, K/64] with strides (xs_row, xs_group)
    int xs_row, xs_group;
    const uint32_t* w_dpas_b;   // [N/16, K/64, 8, 16]
    const float* w_scales_t;    // [K/64, N]
    const float* lora_act;      // [M, R] with row stride lora_ld, or null
    int lora_ld;
    const uint16_t* lora_b;     // [N, R]
    int R;
    const uint16_t* bias;       // [N] or null
    uint16_t* out;              // [M, N]
    int8_t* qout;               // [M, N/2] or null
    float* oscales_t;           // [N/64][os_ld], group-major
    int os_ld;
    const float* q_smooth_inv;  // [N] multiplier applied before output quantization, or null
    float q_rho;                // output quantization clipping ratio
    float* row_sq;              // [M, N/64] or null
    int row_sq_ld;              // row stride for row_sq
    int M, N, K, act;
    bool is_qkv;
};

template <bool HAS_QOUT, bool HAS_ROWSQ, Act ACT>
class SVDQ_GEMM_int4;

inline float quantize_tile8x64_bf16(sycl::sub_group sg, int lane, const u16x8 (&y16)[kTilesN],
                                    const float* sinv_col, int8_t* dst, size_t ld, int rows, float rho) {
    float si[kTilesN];
    #pragma unroll
    for (int t = 0; t < kTilesN; ++t) {
        si[t] = sinv_col ? sinv_col[16 * t + lane] : 1.0f;
    }

    float amax[kTileM];
    #pragma unroll
    for (int m = 0; m < kTileM; ++m) {
        float mx = 0.0f;
        #pragma unroll
        for (int t = 0; t < kTilesN; ++t) {
            mx = sycl::fmax(mx, sycl::fabs(bf16_to_f32(y16[t][m]) * si[t]));
        }
        amax[m] = mx;
    }

    float scale_row[kTileM];
    float inv_row[kTileM];
    #pragma unroll
    for (int m = 0; m < kTileM; ++m) {
        const float mx = sycl::reduce_over_group(sg, amax[m], sycl::maximum<float>());
        const float s = sycl::fmax(mx * rho / 7.0f, 1e-8f);
        scale_row[m] = s;
        inv_row[m] = 1.0f / s;
    }

    #pragma unroll
    for (int p = 0; p < kTileM / 2; ++p) {
        uint32_t d = 0;
        #pragma unroll
        for (int half = 0; half < 2; ++half) {
            const int m = 2 * p + half;
            const float inv = inv_row[m];
            #pragma unroll
            for (int t = 0; t < kTilesN; ++t) {
                const uint32_t q = quant_nibble(bf16_to_f32(y16[t][m]) * si[t], inv);
                uint32_t w = q | (sycl::shift_group_left(sg, q, 1) << 4);
                w |= sycl::shift_group_left(sg, w, 2) << 8;
                w |= sycl::shift_group_left(sg, w, 4) << 16;
                const uint32_t w0 = sycl::select_from_group(sg, w, 0);
                const uint32_t w8 = sycl::select_from_group(sg, w, 8);
                const uint32_t pick = (lane & 1) ? w8 : w0;
                if ((lane >> 3) == half && ((lane & 7) >> 1) == t) d = pick;
            }
        }
        const int row = 2 * p + (lane >> 3);
        if (row < rows) *reinterpret_cast<uint32_t*>(dst + row * ld + 4 * (lane & 7)) = d;
    }
    return scale_row[lane >> 1];
}

constexpr int kMaxRankBlocks = 8;   // LoRA rank <= 128

// RB > 0: LoRA rank is exactly 16 * RB (compile-time); RB == 0: any rank up to 16 * kMaxRankBlocks at run time.
template <bool HAS_QOUT, bool HAS_ROWSQ, Act ACT, int RB>
inline void gemm_epilogue(sycl::sub_group sg, int lane, const GemmArgs& p, f32x8 (&acc)[kTilesN], int m0, int ng) {
    const int M = p.M, N = p.N;
    const int n0 = ng * kGroup;

    if (p.lora_act != nullptr) {
        // lora_act tile (8 rows x 16 ranks per block) -> bf16 A operands, converted once per tile.
        constexpr int KB = RB > 0 ? RB : kMaxRankBlocks;
        const int nkb = RB > 0 ? RB : p.R / 16;
        const int kb_offset = p.is_qkv ? ((n0 / (p.N / 3)) * (p.R / 16)) : 0;  // a 64-col group never straddles a split
        u16x8 la[KB];
        #pragma unroll
        for (int kb = 0; kb < KB; ++kb) {
            if (RB > 0 || kb < nkb) {
                const auto raw = __builtin_IB_subgroup_block_read_flat_u32_m8k16v1(
                    intptr_t(p.lora_act), p.lora_ld * 4 - 1, M - 1, p.lora_ld * 4 - 1, coord2{(kb_offset + kb) * 16, m0});
                #pragma unroll
                for (int m = 0; m < kTileM; ++m) la[kb][m] = f32_to_bf16(sycl::bit_cast<float>(raw[m]));
            }
        }
        #pragma unroll
        for (int t = 0; t < kTilesN; ++t) {
            f32x8 up = {};
            const uint16_t* b_row = p.lora_b + uint32_t(n0 + 16 * t + lane) * uint32_t(p.R);
            #pragma unroll
            for (int kb = 0; kb < KB; ++kb)
                if (RB > 0 || kb < nkb) dpas_bf16(up, la[kb], *reinterpret_cast<const u32x8*>(b_row + kb * 16));
            acc[t] += up;
        }
    }

    u16x8 y16[kTilesN];
    #pragma unroll
    for (int t = 0; t < kTilesN; ++t) {
        const float bias = p.bias != nullptr ? bf16_to_f32(p.bias[n0 + 16 * t + lane]) : 0.0f;
        #pragma unroll
        for (int m = 0; m < kTileM; ++m) {
            float y = acc[t][m] + bias;
            if constexpr (ACT == kActGeluTanh) y = gelu_tanh(y);
            else if constexpr (ACT == kActSilu) y = silu(y);
            y16[t][m] = f32_to_bf16(y);
        }
        __builtin_IB_subgroup_block_write_flat_u16_m8k16v1(
            intptr_t(p.out), N * 2 - 1, M - 1, N * 2 - 1, coord2{n0 + 16 * t, m0}, y16[t]);
    }

    const int rows = sycl::min(kTileM, M - m0);
    const bool owner = (lane & 1) == 0 && (lane >> 1) < rows;

    if constexpr (HAS_QOUT) {
        const float* sinv = p.q_smooth_inv != nullptr ? p.q_smooth_inv + n0 : nullptr;
        const float scale = quantize_tile8x64_bf16(
            sg, lane, y16, sinv, p.qout + size_t(m0) * (N / 2) + ng * 32, N / 2, rows, p.q_rho);
        if (owner) p.oscales_t[size_t(ng) * p.os_ld + m0 + (lane >> 1)] = scale;
    }

    if constexpr (HAS_ROWSQ) {
        float sq[kTileM];
        #pragma unroll
        for (int m = 0; m < kTileM; ++m) {
            float s = 0.0f;
            #pragma unroll
            for (int t = 0; t < kTilesN; ++t) {
                const float y = bf16_to_f32(y16[t][m]);
                s = sycl::fma(y, y, s);
            }
            sq[m] = s;
        }
        float total_row[kTileM];
        #pragma unroll
        for (int m = 0; m < kTileM; ++m) total_row[m] = sycl::reduce_over_group(sg, sq[m], sycl::plus<float>());
        if (owner) p.row_sq[size_t(m0 + (lane >> 1)) * p.row_sq_ld + ng] = total_row[lane >> 1];
    }
}

// ---------------------------------------------------------------------------------------
// GEMM configuration (compile-time, one template instantiation per candidate variant).
//   MT    8-row DPAS blocks per sub-group along M: B tiles are reused MT times from registers
//   NG    64-column quantization groups per sub-group along N
//   SGM, SGN  work-group = SGM x SGN sub-groups (sharing B tiles along M / A tiles along N)
//   SWZ   panel height (in work-groups along M) of the work-group order swizzle
//   GRF   GRF mode, 128 or 256
//   PIPE  1 = load the next K-group's operands while the current one is in the DPAS pipe
//   PFD   cache prefetch distance in K-groups (even; 0 = off)
// ---------------------------------------------------------------------------------------
template <int MT_, int NG_, int SGM_, int SGN_, int SWZ_, int GRF_, int PIPE_, int PFD_>
struct Cfg {
    static constexpr int MT = MT_, NG = NG_, SGM = SGM_, SGN = SGN_, SWZ = SWZ_, GRF = GRF_, PIPE = PIPE_, PFD = PFD_;
    static constexpr int kNT = NG_ * kTilesN;      // 16-column DPAS tiles per sub-group
    static constexpr int tile_m = MT_ * kTileM;    // output rows per sub-group
    static constexpr int tile_n = NG_ * kGroup;    // output columns per sub-group
};

template <class C, bool HAS_QOUT, bool HAS_ROWSQ, Act ACT, int RB>
class SVDQ_GEMM_v;

template <class C>
struct Stage {
    u32x8 b[C::kNT];
    u16x8 a[C::MT];
    sycl::vec<float, C::kNT> sw;
    float sx[C::MT];
};

template <class C, bool HAS_QOUT, bool HAS_ROWSQ, Act ACT, int RB>
void launch_gemm_cfg(sycl::queue& q, const GemmArgs& p) {
    constexpr int MT = C::MT, NG = C::NG, SGM = C::SGM, SGN = C::SGN, kNT = C::kNT;
    const int grid_m = (p.M + C::tile_m - 1) / C::tile_m;
    const int grid_n = p.N / C::tile_n;
    const int groups_m = (grid_m + SGM - 1) / SGM;
    const int groups_n = (grid_n + SGN - 1) / SGN;
    const sycl::range<2> local(SGN * SGM, kSG);
    const sycl::range<2> global(size_t(groups_n) * SGN * SGM, size_t(groups_m) * kSG);

    q.parallel_for<SVDQ_GEMM_v<C, HAS_QOUT, HAS_ROWSQ, ACT, RB>>(
        sycl::nd_range<2>(global, local),
        syclex::properties{syclex::sub_group_size<kSG>, intelex::grf_size<C::GRF>},
        [=](sycl::nd_item<2> item) {
            auto sg = item.get_sub_group();
            const int lane = item.get_local_id(1);
            const int sg_id = item.get_local_id(0);

            // Work-group swizzle: panels of SWZ work-groups along M share the B stream.
            const int linear_wg = int(item.get_group(1)) * groups_n + int(item.get_group(0));
            const int pids_per_panel = C::SWZ * groups_n;
            const int panel_id = linear_wg / pids_per_panel;
            const int first_m = panel_id * C::SWZ;
            const int panel_m_dim = sycl::min(groups_m - first_m, C::SWZ);
            const int in_panel = linear_wg % pids_per_panel;
            const int group_m = first_m + (in_panel % panel_m_dim);
            const int group_n = in_panel / panel_m_dim;

            const int wg_m = group_m * SGM + sg_id % SGM;
            const int wg_n = group_n * SGN + sg_id / SGM;
            const int M = p.M, N = p.N, K = p.K, G = K / kGroup;
            const int m0 = wg_m * C::tile_m;
            const int n0 = wg_n * C::tile_n;
            if (m0 >= M || wg_n >= grid_n) return;

            const uint32_t b_stride = uint32_t(G) * 128u;
            // Operand cursors: loads are issued for K-groups 0, 1, 2, ... in order, so each stream is a
            // running pointer instead of an address recomputed (64-bit multiplies) per group.
            const uint32_t* b_cur = p.w_dpas_b + uint32_t(n0 / 16) * b_stride;
            const float* sw_cur = p.w_scales_t + n0;
            const float* xs_cur[MT];
            #pragma unroll
            for (int mt = 0; mt < MT; ++mt)
                xs_cur[mt] = p.x_scales + uint32_t(sycl::min(m0 + mt * kTileM + (lane & (kTileM - 1)), M - 1)) * uint32_t(p.xs_row);
            int a_x = 0;   // column (in 16-bit units) of the next INT4 activation block

            auto load_stage = [&](int /*g*/, Stage<C>& s) {
                #pragma unroll
                for (int mt = 0; mt < MT; ++mt)
                    s.a[mt] = __builtin_IB_subgroup_block_read_flat_u16_m8k16v1(
                        intptr_t(p.x_q), K / 2 - 1, M - 1, K / 2 - 1, coord2{a_x, m0 + mt * kTileM});
                #pragma unroll
                for (int t = 0; t < kNT; ++t) s.b[t] = load_b_image(sg, b_cur + uint32_t(t) * b_stride);
                s.sw = block_load<float, kNT>(sg, sw_cur);
                #pragma unroll
                for (int mt = 0; mt < MT; ++mt) s.sx[mt] = *xs_cur[mt];
                a_x += kGroup / 4;
                b_cur += 128;
                sw_cur += N;
                #pragma unroll
                for (int mt = 0; mt < MT; ++mt) xs_cur[mt] += p.xs_group;
            };

            // B image viewed as a 2D surface of 64-byte rows: tile (n16, g) = rows [(n16 G + g) 8, +8).
            const int b_rows = (N / 16) * G * 8;
            const int b_row0 = (n0 / 16) * G * 8;
            auto prefetch_stage = [&](int g) {   // g even: covers K-groups g and g + 1
#ifdef __SYCL_DEVICE_ONLY__
                #pragma unroll
                for (int t = 0; t < kNT; ++t)
                    __builtin_IB_subgroup_block_read_prefetch_u16_m16k16v2(
                        intptr_t(p.w_dpas_b), 63, b_rows - 1, 63, coord2{0, b_row0 + t * G * 8 + g * 8}, CacheControl::kL1C_L3C);
                #pragma unroll
                for (int mt = 0; mt < MT; ++mt) {
                    __builtin_IB_subgroup_block_read_prefetch_u8_m8k32v1(
                        intptr_t(p.x_q), K / 2 - 1, M - 1, K / 2 - 1, coord2{g * 32, m0 + mt * kTileM}, CacheControl::kL1C_L3C);
                    __builtin_IB_subgroup_block_read_prefetch_u8_m8k32v1(
                        intptr_t(p.x_q), K / 2 - 1, M - 1, K / 2 - 1, coord2{g * 32 + 32, m0 + mt * kTileM}, CacheControl::kL1C_L3C);
                }
            #endif
            };
            if constexpr (C::PFD > 0) {
                #pragma unroll
                for (int d = 0; d < C::PFD; d += 2)
                    if (d < G) prefetch_stage(d);
            }

            f32x8 acc[MT][NG][kTilesN] = {};
            auto compute_stage = [&](const Stage<C>& s) {
                #pragma unroll
                for (int mt = 0; mt < MT; ++mt) {
                    float sx[kTileM];
                    #pragma unroll
                    for (int m = 0; m < kTileM; ++m) sx[m] = sycl::select_from_group(sg, s.sx[mt], m);
                    #pragma unroll
                    for (int ng = 0; ng < NG; ++ng) {
                        s32x8 c[kTilesN];
                        #pragma unroll
                        for (int t = 0; t < kTilesN; ++t) dpas_s4(c[t], s.a[mt], s.b[ng * kTilesN + t]);
                        #pragma unroll
                        for (int t = 0; t < kTilesN; ++t) {
                            const float sw = s.sw[ng * kTilesN + t];
                            #pragma unroll
                            for (int m = 0; m < kTileM; ++m)
                                acc[mt][ng][t][m] = sycl::fma(float(c[t][m]) * sw, sx[m], acc[mt][ng][t][m]);
                        }
                    }
                }
            };

            auto maybe_prefetch = [&](int g) {
                if constexpr (C::PFD > 0) {
                    if ((g & 1) == 0 && g + C::PFD < G) prefetch_stage(g + C::PFD);
                }
            };
            if constexpr (C::PIPE == 1) {
                Stage<C> s0, s1;
                load_stage(0, s0);
                for (int g = 0; g < G; g += 2) {
                    maybe_prefetch(g);
                    if (g + 1 < G) load_stage(g + 1, s1);
                    compute_stage(s0);
                    if (g + 1 >= G) break;
                    if (g + 2 < G) load_stage(g + 2, s0);
                    compute_stage(s1);
                }
            } else {
                Stage<C> s0;
                for (int g = 0; g < G; ++g) {
                    maybe_prefetch(g);
                    load_stage(g, s0);
                    compute_stage(s0);
                }
            }

            #pragma unroll
            for (int mt = 0; mt < MT; ++mt) {
                if (m0 + mt * kTileM >= M) continue;
                #pragma unroll
                for (int ng = 0; ng < NG; ++ng)
                    gemm_epilogue<HAS_QOUT, HAS_ROWSQ, ACT, RB>(sg, lane, p, acc[mt][ng], m0 + mt * kTileM, n0 / kGroup + ng);
            }
        });
}

// Candidate pool. Fields: MT, NG, SGM, SGN, SWZ, GRF, PIPE, PFD. The first entry is the legacy B70
// configuration (8-row sub-group tiles, 4 x 4 work-groups) and is the fallback for every shape.
#define KF_GEMM_VARIANTS(X) \
    X(0,  1, 1,  4, 4, 4, 128, 0, 0) \
    X(1,  1, 1,  4, 4, 4, 256, 1, 0) \
    X(2,  1, 1,  8, 4, 4, 256, 1, 0) \
    X(3,  1, 1,  4, 8, 4, 256, 1, 0) \
    X(4,  1, 1, 16, 2, 4, 256, 1, 0) \
    X(5,  1, 1,  8, 2, 4, 256, 1, 0) \
    X(6,  1, 1,  4, 4, 8, 256, 1, 0) \
    X(7,  1, 1,  4, 4, 1, 256, 1, 0) \
    X(8,  1, 1,  4, 4, 4, 256, 1, 4) \
    X(9,  2, 1,  4, 4, 4, 256, 0, 0) \
    X(10, 2, 1,  8, 4, 4, 256, 0, 0) \
    X(11, 1, 2,  4, 4, 4, 256, 0, 0) \
    X(12, 1, 1, 16, 4, 4, 128, 0, 0) \
    X(13, 1, 1, 16, 1, 4, 128, 0, 0) \
    X(14, 1, 1,  8, 8, 4, 256, 1, 0)

enum EpiKind : int { kEpiPlain = 0, kEpiRowSq = 1, kEpiGeluQ = 2, kNumEpi = 3 };
using GemmFn = void (*)(sycl::queue&, const GemmArgs&);

struct KernelLimits {
    int64_t max_wg = -1;     // compiled work-group size limit on this device; -1 = unknown
    int64_t private_mem = -1;  // compiled private (spill) bytes per work-item; -1 = unknown
};
using LimitsFn = KernelLimits (*)(sycl::queue&);

struct GemmVariant {
    const char* name;
    int mt, ng, sgm, sgn, swz, grf, pipe, pfd;
    GemmFn fn[kNumEpi];
    LimitsFn limits[kNumEpi];
};

// Compiled-kernel resource report (device-specific work-group limit and spill size) of one instantiation.
template <class C, bool Q, bool R, Act A, int RB>
KernelLimits query_limits(sycl::queue& q) {
    const auto c = kf_sycl_autotune::compiled_kernel_limits<SVDQ_GEMM_v<C, Q, R, A, RB>>(q);
    return {c.max_work_group_size, c.private_mem_size};
}

#define KF_VARIANT_ROW(ID, MT, NG, SGM, SGN, SWZ, GRF, PIPE, PFD)                                                     \
    {"mt" #MT "_ng" #NG "_wg" #SGM "x" #SGN "_swz" #SWZ "_grf" #GRF "_p" #PIPE "_pf" #PFD, MT, NG, SGM, SGN, SWZ, GRF, PIPE, PFD, \
     {&launch_gemm_cfg<Cfg<MT, NG, SGM, SGN, SWZ, GRF, PIPE, PFD>, false, false, kActNone, 2>,                           \
      &launch_gemm_cfg<Cfg<MT, NG, SGM, SGN, SWZ, GRF, PIPE, PFD>, false, true, kActNone, 2>,                            \
      &launch_gemm_cfg<Cfg<MT, NG, SGM, SGN, SWZ, GRF, PIPE, PFD>, true, false, kActGeluTanh, 2>},                  \
     {&query_limits<Cfg<MT, NG, SGM, SGN, SWZ, GRF, PIPE, PFD>, false, false, kActNone, 2>,                         \
      &query_limits<Cfg<MT, NG, SGM, SGN, SWZ, GRF, PIPE, PFD>, false, true, kActNone, 2>,                          \
      &query_limits<Cfg<MT, NG, SGM, SGN, SWZ, GRF, PIPE, PFD>, true, false, kActGeluTanh, 2>}},

static const GemmVariant kGemmVariants[] = {KF_GEMM_VARIANTS(KF_VARIANT_ROW)};
constexpr int kNumGemmVariants = int(sizeof(kGemmVariants) / sizeof(kGemmVariants[0]));

// Epilogue combinations outside the tuned pool (e.g. SiLU) run on the legacy configuration.
using LegacyCfg = Cfg<1, 1, 4, 4, 4, 128, 0, 0>;
void launch_gemm_generic(sycl::queue& q, const GemmArgs& p) {
    const bool has_qout = p.qout != nullptr;
    const bool has_rowsq = p.row_sq != nullptr;
    const Act act = Act(p.act);
    auto go = [&](auto qo, auto rs) {
        constexpr bool QO = decltype(qo)::value, RS = decltype(rs)::value;
        if (act == kActGeluTanh) return launch_gemm_cfg<LegacyCfg, QO, RS, kActGeluTanh, 0>(q, p);
        if (act == kActSilu) return launch_gemm_cfg<LegacyCfg, QO, RS, kActSilu, 0>(q, p);
        return launch_gemm_cfg<LegacyCfg, QO, RS, kActNone, 0>(q, p);
    };
    if (has_qout) { if (has_rowsq) go(std::true_type{}, std::true_type{}); else go(std::true_type{}, std::false_type{}); }
    else { if (has_rowsq) go(std::false_type{}, std::true_type{}); else go(std::false_type{}, std::false_type{}); }
}

// Tuned-pool epilogue family of `p`, or -1 when only the generic path implements it.
inline int epilogue_kind(const GemmArgs& p) {
    const bool qo = p.qout != nullptr, rs = p.row_sq != nullptr;
    if (p.lora_act == nullptr || p.R != 32) return -1;   // pool kernels are specialized for rank-32 LoRA
    if (!qo && !rs && p.act == kActNone) return kEpiPlain;
    if (!qo && rs && p.act == kActNone) return kEpiRowSq;
    if (qo && !rs && p.act == kActGeluTanh) return kEpiGeluQ;
    return -1;
}

void launch_gemm_variant(sycl::queue& q, const GemmArgs& p, int variant) {
    const int kind = epilogue_kind(p);
    if (kind < 0 || variant < 0) return launch_gemm_generic(q, p);
    kGemmVariants[variant].fn[kind](q, p);
}


// ---------------------------------------------------------------------------------------
// Static dispatch (intel-gpu-kernel-dispatch): device facts -> legal candidates -> ranked
// (default, pool) for one GEMM workload. Legality uses queried device limits and the compiled
// kernel's own resource report; performance estimates only reorder the pool, never shrink it.
// ---------------------------------------------------------------------------------------
struct HwInfo {
    std::string name, driver;
    int64_t max_wg = -1;        // device max work-group size; -1 = unknown
    int64_t xve_count = -1;     // vector engines (sycl gpu_eu_count); -1 = unknown
    bool sg16 = false;          // sub-group size 16 offered
};

inline HwInfo query_hw(const sycl::queue& q) {
    const auto d = kf_sycl_autotune::query_sycl_device_info(q);
    HwInfo h;
    h.name = d.name;
    h.driver = d.driver_version;
    h.max_wg = d.max_work_group_size;
    h.xve_count = d.gpu_eu_count;
    for (size_t s : d.sub_group_sizes) h.sg16 |= (s == 16);
    return h;
}

// Workload facts that distinguish GEMM implementations.
struct GemmShape {
    int M, N, K, R;
    int kind;                   // EpiKind
};

// Reasons are reported by the `gemm_pool` diagnostic; nullptr = legal.
inline const char* variant_illegal(const GemmVariant& v, const HwInfo& hw, const GemmShape& s, const KernelLimits& lim) {
    if (!hw.sg16) return "device does not offer sub-group size 16";
    if (s.N % (v.ng * kGroup) != 0) return "N is not a multiple of the sub-group column tile";
    const int64_t threads = int64_t(v.sgm) * v.sgn * kSG;
    if (hw.max_wg < 0 || threads > hw.max_wg) return "work-group exceeds the device limit";
    if (lim.max_wg < 0) return "compiled kernel resource report unavailable";
    if (threads > lim.max_wg) return "work-group exceeds the compiled kernel limit";
    return nullptr;
}

// Priority order (best first) per hardware class and shape class; legal variants missing from a list keep
// table order after the listed ones. Inputs: hardware class from the queried XVE count, and whether the
// reduction is deep (K > 2N), which changes B/A reuse and L3 pressure.
//  * 96-XVE Xe3-LPG class (Panther Lake 12Xe): measured here, 3 interleaved rounds per variant and shape.
//  * Anything else (incl. Arc Pro B70): variant 0 (the configuration tuned on B70 before this pool existed)
//    leads, followed by the Xe3-LPG order; no measurements exist here for such devices, so the runtime
//    autotuner makes the real choice there.
inline std::vector<int> rank_variants(const HwInfo& hw, const GemmShape& s, std::vector<int> legal) {
    static const int kXe3LpgDeepK[] = {1, 2, 5, 8, 7, 4, 9, 0, 13, 12, 10, 11, 3, 6};
    static const int kXe3LpgWide[]  = {1, 6, 5, 9, 2, 8, 3, 4, 0, 7, 11, 10, 13, 12};
    const bool xe3_lpg_class = hw.xve_count > 0 && hw.xve_count <= 128;
    const bool deep_k = s.K > 2 * s.N;
    const int* order = deep_k ? kXe3LpgDeepK : kXe3LpgWide;
    const int n = int(sizeof(kXe3LpgDeepK) / sizeof(int));
    auto pos = [&](int id) {
        if (!xe3_lpg_class && id == 0) return -1;
        for (int i = 0; i < n; ++i) if (order[i] == id) return i;
        return n + id;
    };
    std::stable_sort(legal.begin(), legal.end(), [&](int a, int b) { return pos(a) < pos(b); });
    return legal;
}

// Optional caller restriction of the eligible pool (policy change); empty = all variants.
inline std::vector<int>& eligibility_restriction() {
    static std::vector<int> allowed;
    return allowed;
}

struct StaticSelection {
    int default_id = -1;
    std::vector<int> eligible;                                   // ranked, default first
    std::vector<std::pair<int, const char*>> rejected;
};

inline StaticSelection static_select(sycl::queue& q, const HwInfo& hw, const GemmShape& s) {
    StaticSelection sel;
    std::vector<int> legal;
    for (int i = 0; i < kNumGemmVariants; ++i) {
        const auto& v = kGemmVariants[i];
        if (s.kind < 0) { if (i == 0) legal.push_back(i); continue; }   // epilogue outside the tuned pool: legacy only
        const KernelLimits lim = v.limits[s.kind](q);
        if (const char* why = variant_illegal(v, hw, s, lim)) sel.rejected.push_back({i, why});
        else legal.push_back(i);
    }
    if (const auto& allowed = eligibility_restriction(); !allowed.empty()) {
        std::vector<int> kept;
        for (int id : legal) {
            if (std::find(allowed.begin(), allowed.end(), id) != allowed.end()) kept.push_back(id);
            else sel.rejected.push_back({id, "excluded by the caller's eligibility restriction"});
        }
        legal = kept;
    }
    if (legal.empty()) throw std::runtime_error("no legal SVDQuant GEMM variant for this device and shape");
    sel.eligible = rank_variants(hw, s, legal);
    sel.default_id = sel.eligible.front();
    return sel;
}

// ---------------------------------------------------------------------------------------
// RMSNorm: out[row] *= rsqrt(mean(out[row]^2) + eps) * w, from the GEMM's partial sums.
// One sub-group per row; each lane handles 8 contiguous columns per step.
// ---------------------------------------------------------------------------------------
class RmsNormKernel;

void launch_rmsnorm(sycl::queue& q, uint16_t* out, const float* row_sq, const uint16_t* w, int M, int N, float eps) {
    constexpr int kRowsPerWG = 16;
    const int parts = N / kGroup;
    q.parallel_for<RmsNormKernel>(
        sycl::nd_range<1>(size_t((M + kRowsPerWG - 1) / kRowsPerWG) * kRowsPerWG * kSG, kRowsPerWG * kSG),
        syclex::properties{syclex::sub_group_size<kSG>},
        [=](sycl::nd_item<1> item) {
            auto sg = item.get_sub_group();
            const int lane = sg.get_local_id()[0];
            const int row = int(item.get_global_id(0) / kSG);
            if (row >= M) return;
            float sq = 0.0f;
            for (int j = lane; j < parts; j += kSG) sq += row_sq[size_t(row) * parts + j];
            sq = sycl::reduce_over_group(sg, sq, sycl::plus<float>());
            const float inv_rms = sycl::rsqrt(sq / float(N) + eps);
            using u16x16v = sycl::vec<uint16_t, 16>;
            for (int c = lane * 16; c < N; c += kSG * 16) {
                auto* o = reinterpret_cast<u16x16v*>(out + size_t(row) * N + c);
                const u16x16v y = *o;
                const u16x16v nw = *reinterpret_cast<const u16x16v*>(w + c);
                u16x16v r;
                #pragma unroll
                for (int i = 0; i < 16; ++i) r[i] = f32_to_bf16(bf16_to_f32(y[i]) * inv_rms * bf16_to_f32(nw[i]));
                *o = r;
            }
        });
}

// Fused dual RMSNorm for Q and K slices of the fused QKV GEMM in a single kernel launch
class RmsNormQkKernel;

void launch_rmsnorm_qk(sycl::queue& q, uint16_t* out, int out_stride, const float* row_sq, int row_sq_stride, const uint16_t* w_q, const uint16_t* w_k, int M, int N_per, float eps) {
    constexpr int kRowsPerWG = 16;
    const int parts = N_per / kGroup;
    const int total_rows = 2 * M;
    q.parallel_for<RmsNormQkKernel>(
        sycl::nd_range<1>(size_t((total_rows + kRowsPerWG - 1) / kRowsPerWG) * kRowsPerWG * kSG, kRowsPerWG * kSG),
        syclex::properties{syclex::sub_group_size<kSG>},
        [=](sycl::nd_item<1> item) {
            auto sg = item.get_sub_group();
            const int lane = sg.get_local_id()[0];
            const int global_row = int(item.get_global_id(0) / kSG);
            if (global_row >= total_rows) return;

            const bool is_k = (global_row >= M);
            const int row = is_k ? (global_row - M) : global_row;
            uint16_t* out_slice = is_k ? (out + N_per) : out;
            const float* row_sq_slice = is_k ? (row_sq + parts) : row_sq;
            const uint16_t* w = is_k ? w_k : w_q;

            float sq = 0.0f;
            for (int j = lane; j < parts; j += kSG) sq += row_sq_slice[size_t(row) * row_sq_stride + j];
            sq = sycl::reduce_over_group(sg, sq, sycl::plus<float>());
            const float inv_rms = sycl::rsqrt(sq / float(N_per) + eps);
            using u16x16v = sycl::vec<uint16_t, 16>;
            for (int c = lane * 16; c < N_per; c += kSG * 16) {
                auto* o = reinterpret_cast<u16x16v*>(out_slice + size_t(row) * out_stride + c);
                const u16x16v y = *o;
                const u16x16v nw = *reinterpret_cast<const u16x16v*>(w + c);
                u16x16v r;
                #pragma unroll
                for (int i = 0; i < 16; ++i) r[i] = f32_to_bf16(bf16_to_f32(y[i]) * inv_rms * bf16_to_f32(nw[i]));
                *o = r;
            }
        });
}

// [EVOLVE_END]

// ---------------------------------------------------------------------------------------
// Host bindings
// ---------------------------------------------------------------------------------------
namespace {

const uint16_t* bf16_ptr(const torch::Tensor& t) {
    return reinterpret_cast<const uint16_t*>(t.data_ptr<c10::BFloat16>());
}

void check_bf16(const torch::Tensor& t, const char* name) {
    TORCH_CHECK(t.is_xpu() && t.scalar_type() == torch::kBFloat16 && t.is_contiguous(), name,
                " must be a contiguous XPU bfloat16 tensor");
}

// Per-(row, group) scales are logically [M, G] but stored group-major (a transposed view), so
// the 8 row scales a GEMM sub-group needs per K step are contiguous.
torch::Tensor new_group_major(int M, int G, const torch::TensorOptions& opts) {
    return torch::empty({G, M}, opts.dtype(torch::kFloat32)).t();
}

struct Prologue {
    torch::Tensor x_q, x_scales, lora_act;
};

const float* smooth_ptr(const c10::optional<torch::Tensor>& s, int64_t n, const char* name) {
    if (!s.has_value()) return nullptr;
    TORCH_CHECK(s->is_xpu() && s->scalar_type() == torch::kFloat32 && s->is_contiguous() && s->dim() == 1
                && s->size(0) == n, name, " must be a contiguous XPU float32 tensor of length ", n);
    return s->data_ptr<float>();
}

// Quantizes x * smooth_inv (if `quantize`, group scale amax * rho / 7) and computes
// lora_act = x @ lora_a^T (if lora_a, on the unsmoothed x) in one pass over x.
Prologue run_prologue(sycl::queue& q, const torch::Tensor& x, const c10::optional<torch::Tensor>& lora_a, bool quantize,
                      const c10::optional<torch::Tensor>& smooth_inv = c10::nullopt, float rho = 1.0f) {
    check_bf16(x, "x");
    TORCH_CHECK(x.dim() == 2 && x.size(1) % kGroup == 0, "x must be [M, K] with K % 64 == 0");
    const int M = x.size(0), K = x.size(1);
    const auto opts = x.options();
    const float* si = smooth_ptr(smooth_inv, K, "smooth_inv");
    Prologue r;
    int R = 0;
    if (lora_a.has_value()) {
        check_bf16(*lora_a, "lora_a");
        TORCH_CHECK(lora_a->dim() == 2 && lora_a->size(1) == K, "lora_a must be [R, K]");
        R = lora_a->size(0);
        r.lora_act = torch::empty({M, R}, opts.dtype(torch::kFloat32));
    }
    if (quantize) {
        r.x_q = torch::empty({M, K / 2}, opts.dtype(torch::kInt8));
        r.x_scales = new_group_major(M, K / kGroup, opts);
    }
    if (!quantize && R == 0) return r;
    const uint16_t* la = R > 0 ? bf16_ptr(*lora_a) : nullptr;
    float* act = R > 0 ? r.lora_act.data_ptr<float>() : nullptr;
    if (quantize) {
        dispatch_prologue<true>(q, bf16_ptr(x), M, K, r.x_q.data_ptr<int8_t>(), r.x_scales.data_ptr<float>(),
                                r.x_scales.stride(1), si, rho, la, R, act);
    } else {
        dispatch_prologue<false>(q, bf16_ptr(x), M, K, nullptr, nullptr, 0, nullptr, 1.0f, la, R, act);
    }
    return r;
}

int parse_act(const std::string& act) {
    if (act == "gelu_tanh") return kActGeluTanh;
    if (act == "silu") return kActSilu;
    TORCH_CHECK(act == "none", "unsupported activation ", act);
    return kActNone;
}

}  // namespace

int env_variant() {
    const char* e = std::getenv("KF_VARIANT");
    return e ? std::atoi(e) : -1;
}

bool autotune_enabled() {
    const char* e = std::getenv("KF_AUTOTUNE");
    return !(e && std::atoi(e) == 0);
}

// ---------------------------------------------------------------------------------------
// Runtime selection (runtime-autotune): the static pool of `static_select` is validated and timed as
// complete operations (GEMM + RMSNorm pass) by the native SyclRuntimeAutotuner; the winner is cached
// on disk (keyed by source/build, device/driver, workload, policy, pool) and memoized in-process.
// ---------------------------------------------------------------------------------------
struct SelectionRecord {
    std::string workload, winner;
    double elapsed_ms = 0.0;
    bool from_cache = false, tuned = false;
    std::vector<std::string> pool;
    std::map<std::string, double> median_ms;   // cold searches: finalists' median time of the full operation
};
SelectionRecord g_last_selection;
std::mutex g_select_mu;
int g_epoch = 0;   // bumped when the eligibility restriction changes: memoized winners are scoped to it

int g_last_used = -1;   // variant id used by the most recent tuned-pool call
std::unordered_map<std::string, int> g_selected;   // workload -> variant id (retained winner per exact workload)

std::string build_identity() {
    std::string sig = std::string(__DATE__) + __TIME__;
    for (int i = 0; i < kNumGemmVariants; ++i) sig += kGemmVariants[i].name;
    return "svdq-w4a4-gemm-" + kf_sycl_autotune::fnv1a64(sig);
}

std::string workload_key(const GemmArgs& p, int kind, bool x_int4) {
    std::ostringstream o;
    o << "E" << g_epoch << "_M" << p.M << "_N" << p.N << "_K" << p.K << "_R" << (p.lora_act ? p.R : 0) << "_epi" << kind << "_act" << p.act
      << "_bias" << (p.bias != nullptr) << "_qkv" << p.is_qkv << "_xint4" << x_int4 << "_bf16out";
    return o.str();
}

bool outputs_match(const torch::Tensor& got, const torch::Tensor& ref) {
    if (!got.is_floating_point()) {   // packed INT4: a rounding tie may flip a rare nibble
        const double bad = (got != ref).to(torch::kFloat32).mean().item<double>();
        return bad <= 1e-3;
    }
    return torch::allclose(got.to(torch::kFloat32), ref.to(torch::kFloat32), 2e-2, 2e-2);
}

// run(variant) launches the complete operation (GEMM + post passes) into the preallocated `outs`.
void run_tuned(sycl::queue& q, const GemmArgs& p, bool x_int4, const std::function<void(int)>& run,
               const std::vector<torch::Tensor>& outs) {
    if (const int forced = env_variant(); forced >= 0 && forced < kNumGemmVariants) return run(forced);
    const int kind = epilogue_kind(p);
    if (kind < 0) return run(-1);   // epilogue combination outside the tuned pool (legacy implementation)
    const std::string wl = workload_key(p, kind, x_int4);
    {
        std::lock_guard<std::mutex> lock(g_select_mu);
        auto it = g_selected.find(wl);
        if (it != g_selected.end()) { g_last_used = it->second; run(it->second); return; }
    }
    const HwInfo hw = query_hw(q);
    const StaticSelection sel = static_select(q, hw, GemmShape{p.M, p.N, p.K, p.lora_act ? p.R : 0, kind});
    auto remember = [&](int id, const std::string& winner, double ms, bool cached, bool tuned) {
        std::lock_guard<std::mutex> lock(g_select_mu);
        g_selected[wl] = id;
        g_last_used = id;
        g_last_selection = {wl, winner, ms, cached, tuned, {}, {}};
        for (int v : sel.eligible) g_last_selection.pool.push_back(kGemmVariants[v].name);
    };
    if (!autotune_enabled() || sel.eligible.size() < 2) {
        remember(sel.default_id, kGemmVariants[sel.default_id].name, 0.0, false, false);
        return run(sel.default_id);
    }

    // Fixed oracle for validation: the static default's output (itself checked against the torch
    // reference by the task tests); every variant accumulates in the same K order.
    run(sel.default_id);
    q.wait_and_throw();
    std::vector<torch::Tensor> refs;
    for (const auto& o : outs) refs.push_back(o.clone());
    auto validate = [&]() {
        for (size_t i = 0; i < outs.size(); ++i)
            if (!outputs_match(outs[i], refs[i])) return false;
        return true;
    };

    using namespace kf_sycl_autotune;
    std::vector<SyclVariantSpec> variants;
    for (int id : sel.eligible) {
        const auto& v = kGemmVariants[id];
        variants.push_back({v.name,
                            {{"id", id}, {"mt", v.mt}, {"ng", v.ng}, {"sgm", v.sgm}, {"sgn", v.sgn},
                             {"swz", v.swz}, {"grf", v.grf}, {"pipe", v.pipe}, {"pfd", v.pfd}},
                            nullptr, [&run, id] { run(id); }});
    }
    StaticPolicy policy = [&](const std::string&) {
        std::vector<std::string> names;
        for (const auto& v : variants) names.push_back(v.name);
        return std::make_pair(names.front(), names);
    };
    const auto t0 = std::chrono::steady_clock::now();
    try {
        const TuneResult r = SyclRuntimeAutotuner::instance().select_and_launch(
            q, build_identity(), wl, variants, validate, default_cache_dir(), 2, 5, policy, "svdq-policy-v1",
            "icpx-fsycl-aot sg16 per-variant-grf");
        q.wait_and_throw();
        const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
        remember(r.parameters.at("id"), r.winner_name, ms, r.from_cache, true);
        for (const auto& [name, s] : r.median_seconds) g_last_selection.median_ms[name] = s * 1e3;
    } catch (const std::exception&) {
        // Selection itself failed (e.g. unwritable cache dir, every candidate rejected): the static default
        // is a legal, validated implementation, so keep the operation working.
        remember(sel.default_id, kGemmVariants[sel.default_id].name, 0.0, false, false);
        run(sel.default_id);
    }
}

py::object torch_svdquant_w4a4_gemm(
    torch::Tensor x,
    torch::Tensor w_dpas_b,
    torch::Tensor w_scales,
    c10::optional<torch::Tensor> x_scales_opt,
    c10::optional<torch::Tensor> lora_a_opt,
    c10::optional<torch::Tensor> lora_b_opt,
    c10::optional<torch::Tensor> bias_opt,
    c10::optional<torch::Tensor> norm_w_opt,
    float norm_eps,
    std::string activation,
    bool fuse_quant_out,
    c10::optional<torch::Tensor> x_bf16_opt,
    c10::optional<torch::Tensor> x_lora_opt,
    c10::optional<torch::Tensor> x_smooth_inv_opt,
    float x_rho,
    c10::optional<torch::Tensor> out_smooth_inv_opt,
    float out_rho
) {
    sycl::queue& q = c10::xpu::getCurrentXPUStream().queue();
    TORCH_CHECK(w_dpas_b.is_xpu() && w_dpas_b.scalar_type() == torch::kInt32 && w_dpas_b.dim() == 4 && w_dpas_b.is_contiguous(),
                "w_dpas_b must be the contiguous XPU int32 [N/16, K/64, 8, 16] DPAS B image "
                "(see convert_int4_weights_to_dpas_b)");
    const bool x_is_int4 = x.scalar_type() == torch::kInt8;
    const int M = x.size(0);
    const int K = x_is_int4 ? x.size(1) * 2 : x.size(1);
    const int N = w_dpas_b.size(0) * 16;
    const auto opts = x.options();
    TORCH_CHECK(w_dpas_b.sizes() == torch::IntArrayRef({N / 16, K / kGroup, 8, 16}), "w_dpas_b must be [N/16, K/64, 8, 16]");
    TORCH_CHECK(N % KF_N_TILE == 0, "N must be a multiple of N_TILE = ", KF_N_TILE);
    TORCH_CHECK(w_scales.is_xpu() && w_scales.scalar_type() == torch::kFloat32 && w_scales.is_contiguous()
                && w_scales.sizes() == torch::IntArrayRef({K / kGroup, N}),
                "w_scales must be the contiguous XPU float32 [K/64, N] scales (see convert_w_scales_to_dpas)");

    const bool has_lora = lora_b_opt.has_value();
    Prologue pro;
    torch::Tensor x_q, x_scales, lora_act;
    if (x_is_int4) {
        TORCH_CHECK(x.is_xpu() && x.is_contiguous(), "x must be a contiguous XPU tensor");
        TORCH_CHECK(x_scales_opt.has_value() && x_scales_opt->is_xpu()
                    && x_scales_opt->sizes() == torch::IntArrayRef({M, K / kGroup}),
                    "XPU x_scales [M, K/64] must be provided when x is INT4");
        x_q = x;
        x_scales = x_scales_opt->to(torch::kFloat32);  // no-op for float32; any strides are accepted
        if (x_scales.stride(0) != 1) x_scales = x_scales.t().contiguous().t();  // group-major: a sub-group's 8 row scales are contiguous
        if (has_lora && !x_lora_opt.has_value()) {
            TORCH_CHECK(x_bf16_opt.has_value() && lora_a_opt.has_value(),
                        "LoRA on INT4 input needs x_lora, or x_bf16 and lora_a");
            pro = run_prologue(q, *x_bf16_opt, lora_a_opt, false);
        }
    } else {
        TORCH_CHECK(x.scalar_type() == torch::kBFloat16, "x must be BF16 or INT8 (packed INT4)");
        pro = run_prologue(q, x, (has_lora && !x_lora_opt.has_value()) ? lora_a_opt : c10::nullopt, true,
                           x_smooth_inv_opt, x_rho);
        x_q = pro.x_q;
        x_scales = pro.x_scales;
    }

    GemmArgs p{};
    if (has_lora) {
        const auto& lb = *lora_b_opt;
        check_bf16(lb, "lora_b");
        lora_act = x_lora_opt.has_value() ? *x_lora_opt : pro.lora_act;
        p.R = lb.size(1);
        TORCH_CHECK(lb.size(0) == N && p.R % 16 == 0, "lora_b must be [N, R] with R % 16 == 0");
        TORCH_CHECK(lora_act.is_xpu() && lora_act.scalar_type() == torch::kFloat32 && lora_act.stride(1) == 1
                    && lora_act.size(0) == M && lora_act.size(1) == p.R && lora_act.stride(0) % 16 == 0
                    && reinterpret_cast<uintptr_t>(lora_act.data_ptr()) % 64 == 0,
                    "x_lora must be an XPU float32 [M, R] tensor with unit column stride, a row stride "
                    "that is a multiple of 16 and a 64-byte aligned base");
        p.lora_act = lora_act.data_ptr<float>();
        p.lora_ld = lora_act.stride(0);
        p.lora_b = bf16_ptr(lb);
    }

    auto out = torch::empty({M, N}, opts.dtype(torch::kBFloat16));
    torch::Tensor qout, oscales, row_sq;
    if (fuse_quant_out) {
        qout = torch::empty({M, N / 2}, opts.dtype(torch::kInt8));
        oscales = new_group_major(M, N / kGroup, opts);
        p.qout = qout.data_ptr<int8_t>();
        p.oscales_t = oscales.data_ptr<float>();
        p.os_ld = oscales.stride(1);
        p.q_smooth_inv = smooth_ptr(out_smooth_inv_opt, N, "out_smooth_inv");
        p.q_rho = out_rho;
    }
    if (norm_w_opt.has_value()) {
        check_bf16(*norm_w_opt, "norm_weight");
        row_sq = torch::empty({M, N / kGroup}, opts.dtype(torch::kFloat32));
        p.row_sq = row_sq.data_ptr<float>();
        p.row_sq_ld = N / kGroup;
    }
    if (bias_opt.has_value()) {
        check_bf16(*bias_opt, "bias");
        p.bias = bf16_ptr(*bias_opt);
    }
    p.x_q = x_q.data_ptr<int8_t>();
    p.x_scales = x_scales.data_ptr<float>();
    p.xs_row = x_scales.stride(0);
    p.xs_group = x_scales.stride(1);
    p.w_dpas_b = reinterpret_cast<const uint32_t*>(w_dpas_b.data_ptr<int32_t>());
    p.w_scales_t = w_scales.data_ptr<float>();
    p.out = reinterpret_cast<uint16_t*>(out.data_ptr<c10::BFloat16>());
    p.M = M;
    p.N = N;
    p.K = K;
    p.act = parse_act(activation);
    p.is_qkv = false;
    const uint16_t* norm_ptr = norm_w_opt.has_value() ? bf16_ptr(*norm_w_opt) : nullptr;
    std::vector<torch::Tensor> outs{out};
    if (fuse_quant_out) { outs.push_back(qout); outs.push_back(oscales); }
    run_tuned(q, p, x_is_int4, [&](int v) {
        launch_gemm_variant(q, p, v);
        if (norm_ptr != nullptr) launch_rmsnorm(q, p.out, p.row_sq, norm_ptr, M, N, norm_eps);
    }, outs);

    if (fuse_quant_out) return py::make_tuple(out, qout, oscales);
    return py::cast(out);
}

py::tuple torch_svdquant_w4a4_qkv_gemm(
    torch::Tensor x,
    torch::Tensor w_dpas_b,
    torch::Tensor w_scales,
    torch::Tensor x_scales,
    torch::Tensor lora_b,
    c10::optional<torch::Tensor> bias_opt,
    torch::Tensor x_lora,
    torch::Tensor norm_q_w,
    torch::Tensor norm_k_w,
    float norm_eps
) {
    sycl::queue& q = c10::xpu::getCurrentXPUStream().queue();
    const int M = x.size(0);
    const int K = x.size(1) * 2;  // x is packed int8
    const int N = w_dpas_b.size(0) * 16;  // e.g. 9216 (3072 * 3)
    const int N_per = N / 3;             // 3072
    const auto opts = x.options();

    GemmArgs p{};
    check_bf16(lora_b, "lora_b");
    p.R = lora_b.size(1);
    p.lora_act = x_lora.data_ptr<float>();
    p.lora_ld = x_lora.stride(0);
    p.lora_b = bf16_ptr(lora_b);

    auto out = torch::empty({M, N}, opts.dtype(torch::kBFloat16));
    auto row_sq = torch::empty({M, N / kGroup}, opts.dtype(torch::kFloat32));
    p.row_sq = row_sq.data_ptr<float>();
    p.row_sq_ld = N / kGroup;

    if (bias_opt.has_value()) {
        check_bf16(*bias_opt, "bias");
        p.bias = bf16_ptr(*bias_opt);
    }
    p.x_q = x.data_ptr<int8_t>();
    p.x_scales = x_scales.data_ptr<float>();
    p.xs_row = x_scales.stride(0);
    p.xs_group = x_scales.stride(1);
    p.w_dpas_b = reinterpret_cast<const uint32_t*>(w_dpas_b.data_ptr<int32_t>());
    p.w_scales_t = w_scales.data_ptr<float>();
    p.out = reinterpret_cast<uint16_t*>(out.data_ptr<c10::BFloat16>());
    p.M = M;
    p.N = N;
    p.K = K;
    p.act = kActNone;
    p.is_qkv = true;
    check_bf16(norm_q_w, "norm_q_w");
    check_bf16(norm_k_w, "norm_k_w");
    const int row_sq_parts = N / kGroup;
    run_tuned(q, p, true, [&](int v) {
        launch_gemm_variant(q, p, v);
        // Fused RMSNorm of the Q and K slices in a single launch
        launch_rmsnorm_qk(q, p.out, N, p.row_sq, row_sq_parts, bf16_ptr(norm_q_w), bf16_ptr(norm_k_w), M, N_per, norm_eps);
    }, {out});

    auto out_q = out.narrow(1, 0, N_per);
    auto out_k = out.narrow(1, N_per, N_per);
    auto out_v = out.narrow(1, 2 * N_per, N_per);
    return py::make_tuple(out_q, out_k, out_v);
}

py::tuple torch_quantize_activation_int4(torch::Tensor x, c10::optional<torch::Tensor> lora_a,
                                         c10::optional<torch::Tensor> smooth_inv, float rho) {
    auto r = run_prologue(c10::xpu::getCurrentXPUStream().queue(), x, lora_a, true, smooth_inv, rho);
    if (lora_a.has_value()) return py::make_tuple(r.x_q, r.x_scales, r.lora_act);
    return py::make_tuple(r.x_q, r.x_scales);
}

py::dict variant_params(int id) {
    const auto& v = kGemmVariants[id];
    py::dict d;
    d["mt"] = v.mt; d["ng"] = v.ng; d["sgm"] = v.sgm; d["sgn"] = v.sgn;
    d["swz"] = v.swz; d["grf"] = v.grf; d["pipe"] = v.pipe; d["pfd"] = v.pfd;
    return d;
}

py::dict gemm_pool_info(int M, int N, int K, int R, int kind) {
    sycl::queue& q = c10::xpu::getCurrentXPUStream().queue();
    const HwInfo hw = query_hw(q);
    const StaticSelection sel = static_select(q, hw, GemmShape{M, N, K, R, kind});
    py::dict d;
    d["device"] = hw.name;
    d["driver"] = hw.driver;
    d["xve_count"] = hw.xve_count;
    d["default"] = kGemmVariants[sel.default_id].name;
    py::list pool, rej;
    for (int v : sel.eligible) pool.append(kGemmVariants[v].name);
    for (const auto& r : sel.rejected) rej.append(py::make_tuple(kGemmVariants[r.first].name, r.second));
    d["pool"] = pool;
    d["rejected"] = rej;
    py::list pool_p, rej_p;   // integer configurations, same order as pool / rejected
    for (int v : sel.eligible) pool_p.append(variant_params(v));
    for (const auto& r : sel.rejected) rej_p.append(variant_params(r.first));
    d["pool_params"] = pool_p;
    d["rejected_params"] = rej_p;
    return d;
}

py::dict last_selection_info() {
    std::lock_guard<std::mutex> lock(g_select_mu);
    py::dict d;
    d["workload"] = g_last_selection.workload;
    d["winner"] = g_last_selection.winner;
    d["from_cache"] = g_last_selection.from_cache;
    d["tuned"] = g_last_selection.tuned;
    d["select_ms"] = g_last_selection.elapsed_ms;
    d["pool"] = g_last_selection.pool;
    d["median_ms"] = g_last_selection.median_ms;
    return d;
}

void clear_selection_memo() {
    std::lock_guard<std::mutex> lock(g_select_mu);
    g_selected.clear();
    kf_sycl_autotune::SyclRuntimeAutotuner::instance().clear_memory_cache();
}

py::dict selection_stats() {
    std::lock_guard<std::mutex> lock(g_select_mu);
    // Counted by the tuner at its real search/validate/benchmark boundaries; candidates are named, so map to ids.
    const auto s = kf_sycl_autotune::SyclRuntimeAutotuner::instance().stats();
    auto ids = [](const std::set<std::string>& names) {
        std::vector<int> out;
        for (int i = 0; i < kNumGemmVariants; ++i)
            if (names.count(kGemmVariants[i].name)) out.push_back(i);
        return out;
    };
    py::dict d;
    d["searches"] = s.searches; d["benchmarks"] = s.benchmarks; d["validations"] = s.validations;
    d["benchmarked"] = ids(s.benchmarked);
    d["validated"] = ids(s.validated);
    return d;
}

void reset_selection_stats() {
    std::lock_guard<std::mutex> lock(g_select_mu);
    kf_sycl_autotune::SyclRuntimeAutotuner::instance().reset_stats();
}

void set_eligible(std::vector<int> ids) {
    std::lock_guard<std::mutex> lock(g_select_mu);
    eligibility_restriction() = ids;
    ++g_epoch;
    g_selected.clear();
}

int last_used_variant() { std::lock_guard<std::mutex> lock(g_select_mu); return g_last_used; }

py::list gemm_variant_params() {
    py::list l;
    for (int i = 0; i < kNumGemmVariants; ++i) l.append(variant_params(i));
    return l;
}

py::list gemm_variant_names() {
    py::list l;
    for (int i = 0; i < kNumGemmVariants; ++i) l.append(kGemmVariants[i].name);
    return l;
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
    m.def("svdquant_w4a4_gemm", &torch_svdquant_w4a4_gemm,
          py::arg("x"),
          py::arg("w_dpas_b"),
          py::arg("w_scales"),
          py::arg("x_scales") = py::none(),
          py::arg("lora_a") = py::none(),
          py::arg("lora_b") = py::none(),
          py::arg("bias") = py::none(),
          py::arg("norm_weight") = py::none(),
          py::arg("norm_eps") = 1e-5,
          py::arg("activation") = "none",
          py::arg("fuse_quant_out") = false,
          py::arg("x_bf16") = py::none(),
          py::arg("x_lora") = py::none(),
          py::arg("x_smooth_inv") = py::none(),
          py::arg("x_rho") = 1.0f,
          py::arg("out_smooth_inv") = py::none(),
          py::arg("out_rho") = 1.0f,
          "Fused SVDQuant W4A4 GEMM + BF16 LoRA + bias/activation, optional fused output INT4 "
          "quantization and RMSNorm. x is BF16 (x * x_smooth_inv quantized with group scale "
          "amax * x_rho / 7 and LoRA-down projected on the fly) or packed INT4 with x_scales; "
          "x_lora = x @ lora_a^T (f32) may be supplied precomputed. The fused INT4 output "
          "quantizes out * out_smooth_inv with group scale amax * out_rho / 7.");
    m.def("svdquant_w4a4_qkv_gemm", &torch_svdquant_w4a4_qkv_gemm,
          py::arg("x"),
          py::arg("w_dpas_b"),
          py::arg("w_scales"),
          py::arg("x_scales"),
          py::arg("lora_b"),
          py::arg("bias") = py::none(),
          py::arg("x_lora") = py::none(),
          py::arg("norm_q_w") = py::none(),
          py::arg("norm_k_w") = py::none(),
          py::arg("norm_eps") = 1e-5,
          "Fused Q+K+V SVDQuant GEMM (N=9216): single launch with piecewise RMSNorm on Q and K.");
    m.def("gemm_pool", &gemm_pool_info, py::arg("M"), py::arg("N"), py::arg("K"), py::arg("R") = 32, py::arg("kind") = 0,
          "Static dispatch for one GEMM workload: default and legal pool (kind 0 plain, 1 RMSNorm partials, 2 gelu + INT4 output).");
    m.def("last_selection", &last_selection_info, "Result of the most recent runtime selection.");
    m.def("clear_selection_memo", &clear_selection_memo, "Forget in-process winners (disk cache is kept).");
    m.def("selection_stats", &selection_stats, "Counters of what runtime selection actually did (searches, measurements, validations).");
    m.def("reset_selection_stats", &reset_selection_stats);
    m.def("last_used_variant", &last_used_variant, "Variant id used by the most recent tuned-pool call.");
    m.def("set_eligible", &set_eligible, py::arg("ids"), "Restrict the eligible pool to these variant ids (empty = all).");
    m.def("gemm_variant_params", &gemm_variant_params, "Integer configuration of every compiled variant.");
    m.def("gemm_variants", &gemm_variant_names, "Names of the compiled GEMM variants.");
    m.def("quantize_activation_int4", &torch_quantize_activation_int4,
          py::arg("x"),
          py::arg("lora_a") = py::none(),
          py::arg("smooth_inv") = py::none(),
          py::arg("rho") = 1.0f,
          "INT4 group-64 quantization of x * smooth_inv (group scale amax * rho / 7); with lora_a "
          "([R, K], e.g. several layers' lora_a concatenated) also returns x @ lora_a^T (on the "
          "unsmoothed x) in float32 from the same pass over x.");
}
