#include <torch/extension.h>
#include <c10/xpu/XPUStream.h>

#include <cute/tensor.hpp>
#include <cutlass/epilogue/collective/default_epilogue.hpp>
#include <cutlass/kernel_hardware_info.hpp>
#include <cutlass/util/packed_stride.hpp>
#include <flash_attention_v2/collective/fmha_fusion.hpp>
#include <flash_attention_v2/kernel/xe_fmha_fwd_kernel.hpp>
#include <flash_attention_v2/kernel/xe_tile_scheduler.hpp>
#include <sycl/ext/intel/experimental/grf_size_properties.hpp>

#include <cmath>

using namespace cute;

namespace {

template <typename Element, int HeadDim>
void launch_tla_attention(sycl::queue &queue, const Element *q, const Element *k,
                          const Element *v, Element *o, int batch, int q_len,
                          int kv_len, int heads) {
  using ShapeQK = std::conditional_t<HeadDim == 64,
      Shape<_128, _64, _32>, Shape<_256, _32, _32>>;
  using ShapePV = std::conditional_t<HeadDim == 64,
      Shape<_128, _32, _64>, Shape<_256, _32, _32>>;
  using ShapeOutput = std::conditional_t<HeadDim == 64,
      Shape<_128, _64>, Shape<_256, _128>>;
  using SubgroupLayoutQK = std::conditional_t<HeadDim == 64,
      Layout<Shape<_8, _1, _1>>, Layout<Shape<_16, _1, _1>>>;
  using StrideQ = Stride<int, _1, int, int>;
  using StrideK = Stride<int, _1, int, int>;
  using StrideV = Stride<_1, int, int, int>;
  using StrideO = Stride<int, _1, int, int>;

  using MMAOperation = XE_DPAS_TT<cute::gcd(16, 8), float, Element>;
  using TiledMMAQK = typename TiledMMAHelper<
      MMA_Atom<MMAOperation>, Layout<ShapeQK>, SubgroupLayoutQK>::TiledMMA;
  using SubgroupLayoutPV = decltype(
      cutlass::fmha::collective::get_sg_layout_pv(SubgroupLayoutQK{}));
  using TiledMMAPV = typename TiledMMAHelper<
      MMA_Atom<MMAOperation>, Layout<ShapePV>, SubgroupLayoutPV>::TiledMMA;

  auto make_dummy_tensor = [](auto value, auto stride_value) {
    return make_tensor(make_gmem_ptr(&value),
                       make_layout(repeat<rank_v<decltype(stride_value)>>(1),
                                   stride_value));
  };
  using TensorQ = decltype(make_dummy_tensor(Element{}, StrideQ{}));
  using TensorK = decltype(make_dummy_tensor(Element{}, StrideK{}));
  using TensorV = decltype(make_dummy_tensor(Element{}, StrideV{}));
  using TensorO = decltype(make_dummy_tensor(Element{}, StrideO{}));
  using StrideScale = Stride<_1, int, int, int>;
  using TensorScale = decltype(make_dummy_tensor(float{}, StrideScale{}));

  using Mainloop = cutlass::fmha::collective::FMHAFwdMainloop<
      cutlass::fmha::XeDefault<2>, false, false, false, false, false, false,
      TiledMMAQK, TiledMMAPV, HeadDim == 64 ? 2 : 4, TensorQ, TensorK, TensorV,
      TensorScale, TensorScale, TensorScale, TensorK, TensorV>;
  using Epilogue = cutlass::fmha::collective::FMHAFwdEpilogue<
      Mainloop, ShapeOutput, TensorO>;
  using ProblemShape = cutlass::fmha::kernel::FMHAProblemShape<false>;
  using Scheduler = cutlass::fmha::kernel::XeFHMAIndividualTileScheduler<true, true>;
  using Kernel = cutlass::fmha::kernel::XeFMHAFwdKernel<
      ProblemShape, Mainloop, Epilogue, Scheduler>;

  ProblemShape shape{batch, heads, heads, q_len, kv_len, 0, HeadDim, HeadDim};
  const int head_stride = HeadDim;
  const int q_sequence_stride = heads * head_stride;
  const int kv_sequence_stride = heads * head_stride;
  const int q_batch_stride = q_len * q_sequence_stride;
  const int kv_batch_stride = kv_len * kv_sequence_stride;

  cutlass::KernelHardwareInfo hw_info{
      0, cutlass::KernelHardwareInfo::query_device_multiprocessor_count(0)};
  typename Kernel::Arguments arguments{
      {shape,
       q, {q_sequence_stride, _1{}, head_stride, q_batch_stride},
       k, {kv_sequence_stride, _1{}, head_stride, kv_batch_stride},
       v, {_1{}, kv_sequence_stride, head_stride, kv_batch_stride},
       o, {q_sequence_stride, _1{}, head_stride, q_batch_stride},
       nullptr, {}, nullptr, {}, nullptr, {},
       1.0f, 1.0f, 1.0f, 32,
       k, {kv_sequence_stride, _1{}, head_stride, kv_batch_stride},
       v, {_1{}, kv_sequence_stride, head_stride, kv_batch_stride}, nullptr},
      {1.0f / std::sqrt(static_cast<float>(HeadDim)), nullptr, 0, nullptr},
      {},
      hw_info};

  auto params = Kernel::to_underlying_arguments(arguments, nullptr);
  const auto grid = Kernel::get_grid_shape(params);
  const auto block = Kernel::get_block_shape();
  namespace syclex = sycl::ext::oneapi::experimental;
  namespace intelex = sycl::ext::intel::experimental;
  compat::experimental::launch_properties launch_props{
      syclex::work_group_scratch_size(Kernel::SharedStorageSize)};
  compat::experimental::kernel_properties kernel_props{
      syclex::sub_group_size<cute::intel::sg_size>, intelex::grf_size<256>};
  compat::experimental::launch_policy policy{
      compat::dim3(grid.x, grid.y, grid.z),
      compat::dim3(block.x, block.y, block.z), launch_props, kernel_props};
  compat::experimental::launch<cutlass::device_kernel<Kernel>, Kernel, false>(
      policy, queue, params);
}

template <typename Element>
torch::Tensor forward_tla(torch::Tensor q, torch::Tensor k, torch::Tensor v) {
  TORCH_CHECK(q.is_xpu() && k.is_xpu() && v.is_xpu(), "inputs must be XPU tensors");
  TORCH_CHECK(q.is_contiguous() && k.is_contiguous() && v.is_contiguous(),
              "inputs must be contiguous [B,S,H,D]");
  TORCH_CHECK(q.dim() == 4 && k.dim() == 4 && v.dim() == 4,
              "expected rank-4 tensors");
  TORCH_CHECK(q.scalar_type() == k.scalar_type() && q.scalar_type() == v.scalar_type(),
              "input dtypes must match");
  TORCH_CHECK(q.size(0) == k.size(0) && q.size(0) == v.size(0) &&
                  q.size(2) == k.size(2) && q.size(2) == v.size(2) &&
                  q.size(3) == k.size(3) && q.size(3) == v.size(3) &&
                  k.size(1) == v.size(1),
              "incompatible attention shapes");
  TORCH_CHECK(q.size(3) == 64 || q.size(3) == 128,
              "head dimension must be 64 or 128");
  TORCH_CHECK(q.size(1) > 0 && k.size(1) > 0,
              "sequence lengths must be positive");
  TORCH_CHECK(k.size(1) % (q.size(3) == 64 ? 64 : 32) == 0,
              "TLA non-causal FMHA requires KV length aligned to its key tile");

  const int batch = static_cast<int>(q.size(0));
  const int q_len = static_cast<int>(q.size(1));
  const int kv_len = static_cast<int>(k.size(1));
  const int heads = static_cast<int>(q.size(2));
  const int head_dim = static_cast<int>(q.size(3));
  auto output = torch::empty_like(q);
  auto &queue = c10::xpu::getCurrentXPUStream().queue();
  const auto *q_ptr = reinterpret_cast<const Element *>(q.data_ptr());
  const auto *k_ptr = reinterpret_cast<const Element *>(k.data_ptr());
  const auto *v_ptr = reinterpret_cast<const Element *>(v.data_ptr());
  auto *o_ptr = reinterpret_cast<Element *>(output.data_ptr());

  if (head_dim == 64) {
    launch_tla_attention<Element, 64>(queue, q_ptr, k_ptr, v_ptr, o_ptr,
                                      batch, q_len, kv_len, heads);
  } else {
    launch_tla_attention<Element, 128>(queue, q_ptr, k_ptr, v_ptr, o_ptr,
                                       batch, q_len, kv_len, heads);
  }
  return output;
}

torch::Tensor forward_tla_entry(torch::Tensor q, torch::Tensor k, torch::Tensor v) {
  TORCH_CHECK(q.scalar_type() == torch::kHalf ||
                  q.scalar_type() == torch::kBFloat16,
              "TLA path supports FP16 and BF16");
  if (q.scalar_type() == torch::kHalf) {
    return forward_tla<cutlass::half_t>(q, k, v);
  }
  return forward_tla<cutlass::bfloat16_t>(q, k, v);
}

}  // namespace

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
    module.def("forward", &forward_tla_entry, "SYCL*TLA fused FMHA");
}